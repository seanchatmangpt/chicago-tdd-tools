# Build artifacts
*.o
*.a
*.so
*.dylib
*.exe
*.dll

# Test executables (bin artifacts; test SOURCES are tracked — the old
# tests/chicago_* rule silently ignored real test files, e.g.
# tests/chicago_test_macro_tests.rs)
tests/*_test
tests/*_test.exe

# Rust build artifacts
target/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.backup
*.log

# Documentation backups
CHANGELOG.md.backup
*.md.backup

# Language server cache files
.lh/

# Backup files
README.md.old
vendors/

# OpenTelemetry semantic-conventions registry — cloned at build time by
# build.rs (clone_registry) for Weaver validation; never source, never
# published (see Cargo.toml `exclude`). It was previously committed as a
# stray gitlink (mode 160000) with no matching .gitmodules entry, which
# made `git status` perpetually report it as dirty/modified content.
registry/

# ggen working state (generated keys, caches) — never source
.ggen/

# Agent and temporary files
.agents/
check_output.txt
cookbook/book-test/
ORIGINAL_REQUEST.md
spec-harness/CERTIFICATION.json

vendors/

# Coverage / generated reports
*.lcov
weaver-reports/

# python bytecode residue
__pycache__/

# Lane-run artifacts (N06 disasm receipts etc.): lanes/ tracks README only;
# live run output stays out of the receipts boundary.
docs/lanes/*.json
mutants.out/

# mdbook build output (regenerable via just cookbook-build)
cookbook/book/

# ggen-v2 working state (same law as .ggen/ — generated receipts/state, never source)
.ggen-v2/

# standalone child-crate locks (root Cargo.lock is intentionally tracked)
playground/Cargo.lock
crates/ctt-splice-digest/Cargo.lock
crates/chicago-lints/Cargo.lock
spec-harness/Cargo.lock
proc_macros/Cargo.lock

# cargo-mutants debris (generated by check-mutation-gate)
mutants.out.old/
mutants.out/
application-guide/book/
