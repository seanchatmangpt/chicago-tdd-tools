@prefix ctdd: <https://chatmangpt.com/ontology/chicago-tdd#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ctdd:Standard a rdfs:Class ; rdfs:subClassOf skos:Concept, dcat:Resource .
ctdd:Refusal a rdfs:Class ; rdfs:subClassOf skos:Concept .
ctdd:Observation a rdfs:Class ; rdfs:subClassOf prov:Entity .
ctdd:ManufacturingActivity a rdfs:Class ; rdfs:subClassOf prov:Activity .
ctdd:Receipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
ctdd:BrokerPolicy a rdfs:Class ; rdfs:subClassOf odrl:Policy .

<urn:ctdd:policy:broker-only> a ctdd:BrokerPolicy ;
  dcterms:title "Broker-only actuation policy" ;
  odrl:permission <urn:ctdd:permission:receipted-filesystem-write> ;
  odrl:prohibition <urn:ctdd:prohibition:direct-hook-actuation> .

<urn:ctdd:std:001> a ctdd:Standard ; ctdd:order 1 ; ctdd:identifier "STD-001" ; dcterms:title "Admitted observation" ; ctdd:phase "admit" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Transform partial observation O into bounded O* before manufacturing." .
<urn:ctdd:std:002> a ctdd:Standard ; ctdd:order 2 ; ctdd:identifier "STD-002" ; dcterms:title "Lawful manufacturing" ; ctdd:phase "manufacture" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Apply only a lawful manufacturing function μ to admitted observation." .
<urn:ctdd:std:003> a ctdd:Standard ; ctdd:order 3 ; ctdd:identifier "STD-003" ; dcterms:title "Zero unreceipted actuation" ; ctdd:phase "actuate" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "No side effect may survive without a colocated consequence receipt." .
<urn:ctdd:std:004> a ctdd:Standard ; ctdd:order 4 ; ctdd:identifier "STD-004" ; dcterms:title "ggen lifecycle" ; ctdd:phase "manufacture" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Resolve, Enrich, Extract, Render, Write, then Receipt." .
<urn:ctdd:std:005> a ctdd:Standard ; ctdd:order 5 ; ctdd:identifier "STD-005" ; dcterms:title "Authored/generated boundary" ; ctdd:phase "render" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Generated files are products, never manually maintained sources." .
<urn:ctdd:std:006> a ctdd:Standard ; ctdd:order 6 ; ctdd:identifier "STD-006" ; dcterms:title "Deterministic replay" ; ctdd:phase "replay" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "A second sync must reproduce byte-identical generated outputs." .
<urn:ctdd:std:007> a ctdd:Standard ; ctdd:order 7 ; ctdd:identifier "STD-007" ; dcterms:title "Receipt v2 closure" ; ctdd:phase "receipt" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Bind Turtle, queries, templates, O*, outputs, utility, tests, and previous receipt." .
<urn:ctdd:std:008> a ctdd:Standard ; ctdd:order 8 ; ctdd:identifier "STD-008" ; dcterms:title "Independent validation" ; ctdd:phase "verify" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Recompute generated bytes independently from the generator runtime." .
<urn:ctdd:std:009> a ctdd:Standard ; ctdd:order 9 ; ctdd:identifier "STD-009" ; dcterms:title "Fail-closed gates" ; ctdd:phase "verify" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Missing or malformed evidence must refuse rather than degrade to success." .
<urn:ctdd:std:010> a ctdd:Standard ; ctdd:order 10 ; ctdd:identifier "STD-010" ; dcterms:title "Intent-only hooks" ; ctdd:phase "hook" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Knowledge hooks manufacture intents and never actuate directly." .
<urn:ctdd:std:011> a ctdd:Standard ; ctdd:order 11 ; ctdd:identifier "STD-011" ; dcterms:title "Standing separation" ; ctdd:phase "authorize" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Candidate, verified, authorized, actuated, and receipted are distinct states." .
<urn:ctdd:std:012> a ctdd:Standard ; ctdd:order 12 ; ctdd:identifier "STD-012" ; dcterms:title "Bounded reversible construction" ; ctdd:phase "construct" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Preserve reversible graph-domain choices until bounded authorization." .
<urn:ctdd:std:013> a ctdd:Standard ; ctdd:order 13 ; ctdd:identifier "STD-013" ; dcterms:title "Public ontology mapping" ; ctdd:phase "enrich" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Map local meaning to PROV-O, DCAT, DCTERMS, SKOS, and ODRL." .
<urn:ctdd:std:014> a ctdd:Standard ; ctdd:order 14 ; ctdd:identifier "STD-014" ; dcterms:title "Chicago TDD real collaborators" ; ctdd:phase "test" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Prefer state verification against real collaborators over fabricated interaction success." .
<urn:ctdd:std:015> a ctdd:Standard ; ctdd:order 15 ; ctdd:identifier "STD-015" ; dcterms:title "Verification ladder" ; ctdd:phase "verify" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Expand proof from unit through integration, e2e, chaos, stress, benchmark, and verifier report." .
<urn:ctdd:std:016> a ctdd:Standard ; ctdd:order 16 ; ctdd:identifier "STD-016" ; dcterms:title "Gall state discipline" ; ctdd:phase "diagnose" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Use PARTIAL_ALIVE, ALIVE, BLOCKED, BUILD_BROKEN, UNKNOWN, and UNSUPPORTED precisely." .
<urn:ctdd:std:017> a ctdd:Standard ; ctdd:order 17 ; ctdd:identifier "STD-017" ; dcterms:title "Typed refusals" ; ctdd:phase "refuse" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Every denied transition names a stable machine-readable refusal code." .
<urn:ctdd:std:018> a ctdd:Standard ; ctdd:order 18 ; ctdd:identifier "STD-018" ; dcterms:title "Read-only permanent validation" ; ctdd:phase "verify" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Permanent validators observe and refuse drift but never repair by writing." .
<urn:ctdd:std:019> a ctdd:Standard ; ctdd:order 19 ; ctdd:identifier "STD-019" ; dcterms:title "Exact-head evidence" ; ctdd:phase "receipt" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Receiver-facing workflow evidence must identify the exact candidate head." .
<urn:ctdd:std:020> a ctdd:Standard ; ctdd:order 20 ; ctdd:identifier "STD-020" ; dcterms:title "OCEL process evidence" ; ctdd:phase "observe" ; ctdd:standing "ADMITTED" ; ctdd:receiptRequirement true ; dcterms:description "Record admitted process events so conformance and replay can be checked." .

<urn:ctdd:refusal:001> a ctdd:Refusal ; ctdd:order 1 ; ctdd:code "CTDD-ADM-001" ; ctdd:name "OBSERVATION_NOT_ADMITTED" ; ctdd:boundary "admission" ; dcterms:description "O* admission fields are missing or false." .
<urn:ctdd:refusal:002> a ctdd:Refusal ; ctdd:order 2 ; ctdd:code "CTDD-GEN-001" ; ctdd:name "GENERATED_OUTPUT_DRIFT" ; ctdd:boundary "generation" ; dcterms:description "Committed generated bytes differ from lawful projection." .
<urn:ctdd:refusal:003> a ctdd:Refusal ; ctdd:order 3 ; ctdd:code "CTDD-GEN-002" ; ctdd:name "HAND_EDITED_GENERATED_OUTPUT" ; ctdd:boundary "generation" ; dcterms:description "A generated product changed without matching authored inputs." .
<urn:ctdd:refusal:004> a ctdd:Refusal ; ctdd:order 4 ; ctdd:code "CTDD-GEN-003" ; ctdd:name "SECOND_SYNC_DRIFT" ; ctdd:boundary "replay" ; dcterms:description "Two generation passes are not byte identical." .
<urn:ctdd:refusal:005> a ctdd:Refusal ; ctdd:order 5 ; ctdd:code "CTDD-RCP-001" ; ctdd:name "MISSING_RECEIPT_COMPONENT" ; ctdd:boundary "receipt" ; dcterms:description "Receipt v2 is missing a required hash component." .
<urn:ctdd:refusal:006> a ctdd:Refusal ; ctdd:order 6 ; ctdd:code "CTDD-RCP-002" ; ctdd:name "RECEIPT_CHAIN_MISMATCH" ; ctdd:boundary "receipt" ; dcterms:description "Previous receipt identity does not match the admitted chain." .
<urn:ctdd:refusal:007> a ctdd:Refusal ; ctdd:order 7 ; ctdd:code "CTDD-ACT-001" ; ctdd:name "DIRECT_ACTUATION_REFUSED" ; ctdd:boundary "actuation" ; dcterms:description "A non-broker path requested a side effect." .
<urn:ctdd:refusal:008> a ctdd:Refusal ; ctdd:order 8 ; ctdd:code "CTDD-ACT-002" ; ctdd:name "UNRECEIPTED_ACTUATION_REFUSED" ; ctdd:boundary "actuation" ; dcterms:description "An actuation lacks a colocated receipt contract." .
<urn:ctdd:refusal:009> a ctdd:Refusal ; ctdd:order 9 ; ctdd:code "CTDD-HOOK-001" ; ctdd:name "HOOK_DIRECT_ACTUATION_REFUSED" ; ctdd:boundary "hook" ; dcterms:description "A hook attempted direct execution instead of emitting intent." .
<urn:ctdd:refusal:010> a ctdd:Refusal ; ctdd:order 10 ; ctdd:code "CTDD-STD-001" ; ctdd:name "PREMATURE_STANDING" ; ctdd:boundary "standing" ; dcterms:description "Admission or checkpoint evidence was overclaimed as ALIVE." .
<urn:ctdd:refusal:011> a ctdd:Refusal ; ctdd:order 11 ; ctdd:code "CTDD-VAL-001" ; ctdd:name "FAIL_OPEN_VALIDATION" ; ctdd:boundary "validation" ; dcterms:description "A validator continued after incomplete or malformed evidence." .
<urn:ctdd:refusal:012> a ctdd:Refusal ; ctdd:order 12 ; ctdd:code "CTDD-VAL-002" ; ctdd:name "EXACT_HEAD_MISMATCH" ; ctdd:boundary "receiver" ; dcterms:description "Published evidence is not bound to the exact candidate head." .
